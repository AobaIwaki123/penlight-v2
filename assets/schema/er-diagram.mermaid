erDiagram
    COLOR ||--o{ SONG : "color1_id"
    COLOR ||--o{ SONG : "color2_id"
    COLOR ||--o{ UPDATE_MEMBER_PENLIGHT_REQUEST : "left_color_id"
    COLOR ||--o{ UPDATE_MEMBER_PENLIGHT_REQUEST : "right_color_id"
    GROUP ||--o{ ANSWER_LOG : "group_id"
    GROUP ||--o{ BATCH_ANSWER_ITEM : "group_id"
    GROUP ||--o{ COLOR : "group_id"
    GROUP ||--o{ GENERATE_QUIZ_REQUEST : "group_id"
    GROUP ||--o{ GROUP_STAT : "group_id"
    GROUP ||--o{ MEMBER : "group_id"
    GROUP ||--o{ PHOTO_TYPE : "group_id"
    GROUP ||--o{ QUIZ_FILTER : "group_id"
    GROUP ||--o{ SONG : "group_id"
    GROUP ||--o{ TARGET_STAT : "group_id"
    MEMBER ||--o{ ANSWER_LOG : "target_member_id"
    MEMBER ||--o{ BATCH_ANSWER_ITEM : "target_member_id"
    MEMBER ||--o{ MEMBER_IMAGE : "member_id"
    MEMBER ||--o{ METADATA_EDIT_PROPOSAL : "member_id"
    MEMBER ||--o{ QUIZ_QUESTION : "target_member_id"
    MEMBER ||--o{ SUBMIT_ANSWER_REQUEST : "target_member_id"
    PHOTO_TYPE ||--o{ MEMBER_IMAGE : "photo_type_id"
    PHOTO_TYPE ||--o{ UPDATE_MEMBER_IMAGE_PHOTO_TYPE_REQUEST : "photo_type_id"
    QUIZ_QUESTION ||--o{ ANSWER_LOG : "quiz_question_id"
    QUIZ_QUESTION ||--o{ BATCH_ANSWER_ITEM : "quiz_question_id"
    QUIZ_QUESTION ||--o{ SUBMIT_ANSWER_REQUEST : "quiz_question_id"
    SERIES ||--o{ GROUP : "series_id"
    SERIES ||--o{ QUIZ_FILTER : "series_id"
    SONG ||--o{ ANSWER_LOG : "target_song_id"
    SONG ||--o{ BATCH_ANSWER_ITEM : "target_song_id"
    USER ||--o{ ANSWER_LOG : "user_id"
    USER ||--o{ BATCH_ANSWER_ITEM : "user_id"
    USER ||--o{ METADATA_EDIT_PROPOSAL : "approver_user_id"
    USER ||--o{ METADATA_EDIT_PROPOSAL : "proposer_user_id"

    GROUP {
        string id PK "grp_... (UUID v7)"
        string series_id FK "ser_... (UUID v7)"
        string name "Formal name, e.g. '日向坂46'"
        string short_name "Short display name, e.g. '日向坂'"
        string slug UK "URL-safe identifier, e.g. 'hinatazaka46', 'aobazaka46'"
        string theme_color_hex "Official theme color, e.g. '#7CC7E8'"
        int display_order "UI sort order"
        boolean is_active "Active status"
        datetime created_at
        datetime updated_at
    }

    COLOR {
        string id PK "col_... (UUID v7)"
        string group_id FK "Optional group owner, nil for common/standard colors"
        string name "Color name, e.g. 'スカイブルー', 'パステルブルー', '青'"
        string hex_code "Hex color code, e.g. '#00BFFF', '#7CC7E8'"
        int display_order "UI sort order within the color selector"
        datetime created_at
        datetime updated_at
    }

    PHOTO_TYPE {
        string id PK "pht_... (UUID v7 surrogate key)"
        string group_id FK "grp_... (FK)"
        string slug UK "e.g. '13th_single', '2nd_album'"
        string name "e.g. '13th Single 制服', '2nd Album アー写'"
        int display_order
        datetime created_at
        datetime updated_at
    }

    MEMBER {
        int metadata_revision
        string id PK "mem_... (UUID v7 immutable surrogate key)"
        string group_id FK "grp_..."
        string family_name "e.g. '加藤'"
        string given_name "e.g. '史帆'"
        string family_name_kana "e.g. 'かとう'"
        string given_name_kana "e.g. 'しほ'"
        int generation "e.g. 1 (1期生)"
        string status "active, graduated, hiatus"
        string penlight "Assigned penlight colors"
        string images "Associated images (1:N, Ref: ADR-0021)"
        datetime joined_at "Optional joining date"
        datetime graduated_at "Optional graduation date"
        datetime verified_at "Timestamp when metadata was verified"
        datetime created_at
        datetime updated_at
    }

    MEMBER_IMAGE {
        string id PK "img_... (UUID v7 surrogate key)"
        string member_id FK "mem_... (FK)"
        string photo_type_id FK "pht_... (FK, Ref: ADR-0021)"
        string photo_type "Associated costume/photo category"
        string image_key "Immutable image filename: e.g. 'img_<uuidv7>.webp'"
        boolean is_primary "true for the primary/default image"
        int display_order
        datetime created_at
        datetime updated_at
    }

    MASTER_VERSION {
        int data_revision
        string id PK "'current'"
        string version "Git commit hash or semantic version"
        datetime updated_at
    }

    METADATA_EDIT_PROPOSAL {
        string id PK
        string member_id FK
        int base_revision
        string changes_json
        string status
        datetime submitted_at
        datetime approved_at
        datetime rejected_at
        string proposer_user_id FK
        string approver_user_id FK
        string rejection_reason
    }

    USER {
        string id PK "usr_<uuidv7>"
        string google_sub UK "Google OIDC unique subject ID"
        string email "Google account email address"
        string display_name "User public display name"
        string avatar_url "Avatar image URL"
        datetime created_at
        datetime last_login_at
    }

    ANSWER_LOG {
        string id PK
        string user_id FK
        string quiz_question_id FK
        string target_member_id FK "mem_... (メンバー問題時)"
        string target_song_id FK "sng_... (楽曲問題時)"
        string group_id FK
        boolean is_correct
        int response_time_ms
        datetime answered_at
    }

    QUIZ_QUESTION {
        string id PK "quiz_... (UUID v7)"
        string target_member_id FK "mem_..."
        string target_member
        string options "Exactly 4 options"
        int correct_index "0-3"
        datetime generated_at
    }

